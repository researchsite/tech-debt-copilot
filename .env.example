# ═══════════════════════════════════════════════════════════════════════════════
# Tech Debt Copilot — Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Sign up at cloud.mongodb.com — need M10+ cluster for Vector Search
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=techdebt_copilot
MONGO_COLLECTION=eol_lifecycle

# ── Fireworks AI (SPONSOR — judge points!) ────────────────────────────────────
# Get from: fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# firefunction-v2 is optimized for tool/function calling — perfect for this agent
LLM_MODEL=accounts/fireworks/models/firefunction-v2

# ── Voyage AI (SPONSOR — judge points!) ───────────────────────────────────────
# voyage-3 → 1024-dimensional vectors
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ── LangSmith (optional but great for debugging traces live at the hackathon) ─
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=techdebt-copilot
